{
  "name": "ruyi-workbench",
  "version": "3.0.2",
  "private": true,
  "description": "Ruyi for Mac — offline-first native agent workbench for Apple Silicon, with Node agents, Web UI and Python document tools.",
  "main": "app/server.js",
  "bin": "app/server.js",
  "scripts": {
    "prestart": "node app/build.js --check",
    "start": "node app/server.js serve",
    "predoctor": "node app/build.js --check",
    "doctor": "node app/server.js doctor",
    "test": "node ../dev-harness/run-all.js",
    "build:desktop": "node tools/build-macos-desktop.js",
    "build:desktop:macos": "node tools/build-macos-desktop.js",
    "package:offline:macos:full": "node tools/package-macos-offline.js --variant full",
    "package:offline:macos:slim": "node tools/package-macos-offline.js --variant slim",
    "package:trial:macos": "node tools/package-macos-trial.js",
    "package:offline": "node tools/package-macos-offline.js --variant full",
    "package:offline:full": "node tools/package-macos-offline.js --variant full",
    "package:offline:slim": "node tools/package-macos-offline.js --variant slim"
  },
  "engines": {
    "node": ">=20"
  }
}
